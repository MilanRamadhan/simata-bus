generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("customer") // "admin" | "customer" | "provider"
  tickets   Ticket[]
  reviews   Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TravelAgency {
  id          String   @id @default(cuid())
  name        String
  logo        String
  description String
  contact     String?  // Kontak agency
  photos      String?  // URL foto bus/agency
  rating      Float
  totalBuses  Int
  routes      String   // Stored as JSON string
  ownerId     String?  // User.id dari penyedia bus (provider) yang memiliki agency ini
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  schedules   BusSchedule[]
  reviews     Review[]
}

model Review {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId  String
  agency    TravelAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  photos    String?      // Foto opsional dari user
  createdAt DateTime     @default(now())
}

model BusSchedule {
  id                String   @id @default(cuid())
  agencyId          String
  agency            TravelAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyName        String
  busName           String
  origin            String
  destination       String
  date              String
  departureTime     String
  arrivalTime       String
  price             Int
  totalSeats        Int
  bookedSeats       String   // Stored as JSON string []
  busClass          String
  isRecurring       Boolean  @default(false)
  recurringDays     String?
  // Status keberangkatan (untuk jadwal tidak berulang)
  scheduleStatus    String?  @default("aktif")  // "aktif" | "ditunda" | "dibatalkan"
  delayNote         String?
  newDepartureTime  String?
  // Override per tanggal (untuk jadwal berulang), stored as JSON string
  dateOverrides     String?  @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Ticket {
  id              String   @id @default(cuid())
  passengerId     String?
  passenger       User?    @relation(fields: [passengerId], references: [id], onDelete: SetNull)
  passengerName   String
  passengerNik    String
  passengerPhone  String
  agencyName      String
  busName         String
  busClass        String
  origin          String
  destination     String
  date            String
  departureTime   String
  arrivalTime     String
  seatNumber      String
  price           Int
  paymentMethod   String
  status          String   @default("Menunggu Pembayaran")
  bookingDate     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
